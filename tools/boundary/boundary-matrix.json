{
  "$schema": "./boundary-matrix.schema.json",
  "schemaVersion": 1,
  "stage": "Gate 4.1 / Stage 1",
  "namespace": "@xiangxu/",
  "packages": {
    "@xiangxu/domain": {
      "path": "packages/domain",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/contracts": "type-only"
      },
      "allowedExternalDependencies": []
      ,"sourceScopedExternalDependencies": [
        { "specifier": "vitest", "include": ["src/**/*.test.ts"] }
      ]
    },
    "@xiangxu/application": {
      "path": "packages/application",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/domain": "runtime",
        "@xiangxu/contracts": "runtime"
      },
      "allowedExternalDependencies": []
      ,"sourceScopedExternalDependencies": [
        { "specifier": "vitest", "include": ["src/**/*.test.ts"] }
      ]
    },
    "@xiangxu/infrastructure": {
      "path": "packages/infrastructure",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/application": "runtime",
        "@xiangxu/contracts": "runtime",
        "@xiangxu/domain": "runtime"
      },
      "allowedExternalDependencies": [
        "@types/pg",
        "bullmq",
        "drizzle-kit",
        "drizzle-orm",
        "drizzle-orm/*",
        "ioredis",
        "node:*",
        "pg"
      ],
      "sourceScopedExternalDependencies": [
        { "specifier": "vitest", "include": ["src/**/*.integration.test.ts"] }
      ],
      "additionalSourceInputs": [
        "drizzle.config.ts",
        "database/schema.ts",
        "scripts/config.mjs",
        "scripts/config-smoke.mjs",
        "scripts/runtime.mjs",
        "scripts/database.mjs",
        "scripts/db-migrate.mjs",
        "scripts/db-smoke.mjs",
        "scripts/queue.mjs",
        "scripts/queue-smoke.mjs",
        "scripts/infra-smoke.mjs",
        "scripts/integration.mjs",
        "scripts/http-integration.mjs",
        "scripts/stage3-http-smoke.mjs",
        "scripts/db-rebuild-smoke.mjs"
      ]
    },
    "@xiangxu/contracts": {
      "path": "packages/contracts",
      "kind": "production",
      "allowedWorkspaceDependencies": {},
      "allowedExternalDependencies": [
        "zod"
      ],
      "sourceScopedExternalDependencies": [
        { "specifier": "vitest", "include": ["src/**/*.test.ts"] }
      ]
    },
    "@xiangxu/ui": {
      "path": "packages/ui",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/contracts": "type-only"
      },
      "allowedExternalDependencies": [
        "react",
        "react/*",
        "@types/react"
      ]
    },
    "@xiangxu/testing": {
      "path": "packages/testing",
      "kind": "test-only",
      "allowedWorkspaceDependencies": {
        "@xiangxu/domain": "runtime",
        "@xiangxu/application": "runtime",
        "@xiangxu/infrastructure": "runtime",
        "@xiangxu/contracts": "runtime",
        "@xiangxu/ui": "runtime",
        "@xiangxu/web": "runtime",
        "@xiangxu/worker": "runtime"
      },
      "allowedExternalDependencies": []
    },
    "@xiangxu/web": {
      "path": "apps/web",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/application": "runtime",
        "@xiangxu/contracts": "runtime",
        "@xiangxu/ui": "runtime"
      },
      "sourceScopedWorkspaceDependencies": [
        {
          "target": "@xiangxu/infrastructure",
          "permission": "runtime",
          "include": ["src/server/composition/**"],
          "forbidClientReachability": true
        }
      ],
      "sourceScopedExternalDependencies": [
        {
          "specifier": "node:*",
          "include": ["src/server/**"],
          "forbidClientReachability": true
        }
      ],
      "allowedExternalDependencies": [
        "@tanstack/react-query",
        "next",
        "next/*",
        "react",
        "react/*",
        "react-dom",
        "react-dom/*",
        "uuid",
        "@types/node",
        "@types/react",
        "@types/react-dom"
      ],
      "additionalSourceInputs": [
        "next.config.mjs",
        "next-env.d.ts"
      ]
    },
    "@xiangxu/worker": {
      "path": "apps/worker",
      "kind": "production",
      "allowedWorkspaceDependencies": {
        "@xiangxu/application": "runtime",
        "@xiangxu/infrastructure": "runtime",
        "@xiangxu/contracts": "runtime"
      },
      "allowedExternalDependencies": [
        "node:*",
        "@types/node"
      ]
    }
  },
  "rules": {
    "forbidProductionDependingOnTesting": true,
    "forbidCrossPackageRelativeImports": true,
    "forbidDeepImports": true,
    "requireDeclaredWorkspaceImports": true,
    "requireWorkspaceProtocol": true,
    "forbidWorkspaceCycles": true
  }
}
