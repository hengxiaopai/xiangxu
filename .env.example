# Gate 4.0 / Stage 1 requires no runtime secrets.
# Add variable names only when the owning Stage introduces the adapter.

# Stage 3 local shell ports. Smoke tests select temporary ports automatically.
WEB_PORT=4310
WORKER_PORT=4311

# Stage 5 local infrastructure only. Replace the password in an ignored local
# environment file; never use these placeholders outside the isolated Docker profile.
XIANGXU_STAGE5_POSTGRES_DB=xiangxu_stage5
XIANGXU_STAGE5_POSTGRES_USER=xiangxu_stage5
XIANGXU_STAGE5_POSTGRES_PASSWORD=replace-with-local-only-password
XIANGXU_STAGE5_POSTGRES_PORT=55432
XIANGXU_STAGE5_REDIS_PORT=6379
DATABASE_URL=postgresql://xiangxu_stage5:replace-with-local-only-password@127.0.0.1:55432/xiangxu_stage5
REDIS_URL=redis://127.0.0.1:6379/0
